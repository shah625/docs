                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,63}-\\d{6}-\\d{4}-\\d{4}(d\\d{1,2})?$",
                      "description": "Market ticker (one window of a series), e.g. \"btc-15m-261002-1400-1415\". Opaque."
                    }
                  },
                  "series_tickers": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                      "description": "Series ticker, e.g. \"btc-15m\"."
