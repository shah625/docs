{
  "asyncapi": "3.0.0",
  "info": {
    "title": "updown Trade API websocket",
    "version": "1.0.0",
    "description": "ONE websocket. Public channels (orderbook_delta, ticker, trade, window_lifecycle, prices) need no key; the private channels (user_orders, fill, market_positions) and cancel_on_disconnect need an API key sent in the handshake (Authorization: Bearer udk_…). Every data message carries a per-subscription seq; a gap means re-request a snapshot. Generated from packages/protocol — do not edit by hand."
  },
  "servers": {
    "production": {
      "host": "api.updown.fast",
      "pathname": "/trade-api/ws/v1",
      "protocol": "wss"
    }
  },
