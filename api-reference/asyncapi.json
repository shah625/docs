                  "symbols": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(X:[A-Z0-9]{2,12}USD|P:[A-Z0-9]{2,12}|K:[A-Z0-9][A-Z0-9._-]{2,80}|[A-Z0-9.]{1,12})$",
                      "description": "Underlying symbol: \"AAPL\", \"X:BTCUSD\", \"P:OPENAI\", \"K:<kalshi market ticker>\"."
                    }
                  }
                },
                "required": [
                  "channels"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "cmd",
              "params"
            ],
            "additionalProperties": false
